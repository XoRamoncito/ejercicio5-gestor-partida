								"$ref": "ULvvv7AfkGXboLpN6QkqvS"
							},
							"tail": {
								"$ref": "mZdO7moJm518xiJTiHuOSA"
							},
							"points": "299:1326;1326:645",
							"lineStyle": 0
						},
						{
							"_type": "UMLNoteView",
							"_id": "hMAdqIyZaCMDP1ktnTPZcy",
							"_parent": {
								"$ref": "UKpN3b5jENhhlQU6eYNYTK"
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"fillColor": "#fff4cc",
							"left": 359,
							"top": 1326,
							"width": 330,
							"height": 153,
							"text": "NO TE REPITAS (DRY)\nColorJugador junta nombre, casilla de\nsalida y tono de cada color (antes\n\"rojo\"/\"azul\" escritos en 12 lugares).\nReglasParchis tiene la única versión de\n\"¿se puede mover?\" (antes copiada en\n3 métodos)."
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "aXXedK24uoJ5F28CLXjYpn",
							"_parent": {
								"$ref": "UKpN3b5jENhhlQU6eYNYTK"
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"head": {
								"$ref": "VCstoZuWfdaiFlS8sLGjPH"
							},
							"tail": {
								"$ref": "hMAdqIyZaCMDP1ktnTPZcy"
							},
							"points": "689:1340;1708:955",
							"lineStyle": 0
						},
						{
							"_type": "UMLNoteView",
							"_id": "G9vsDvlDwPu6lhtQZGxG0Z",
							"_parent": {
								"$ref": "UKpN3b5jENhhlQU6eYNYTK"
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"fillColor": "#dde9f7",
							"left": 729,
							"top": 1326,
							"width": 322,
							"height": 115,
							"text": "COMPOSICIÓN SOBRE HERENCIA\nSe borraron JugadorRojo y JugadorAzul.\nJugador TIENE un ColorJugador:\nun color nuevo es una línea\nen el enum, no una clase nueva."
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "msl3Sams8h2jJ7D4geFnU8",
							"_parent": {
								"$ref": "UKpN3b5jENhhlQU6eYNYTK"
