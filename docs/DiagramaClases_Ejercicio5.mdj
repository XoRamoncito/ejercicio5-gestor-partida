							"_parent": {
								"$ref": "UKpN3b5jENhhlQU6eYNYTK"
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"fillColor": "#dff3e4",
							"left": 20,
							"top": 1326,
							"width": 299,
							"height": 172,
							"text": "UNA SOLA RESPONSABILIDAD\nCada clase hace una sola cosa:\nPartida = reglas y turnos\nTableroPanel = dibujo del tablero\nPanelLateral = botones y etiquetas\nNotificadorSocket = red\nRepositorioEstadisticasMySQL = SQL\nGestorPartida = solo crea y conecta"
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "W3QyPUkwTCSM172C2fprur",
							"_parent": {
								"$ref": "UKpN3b5jENhhlQU6eYNYTK"
							},
							"font": "Arial;13;0",
							"parentStyle": false,
